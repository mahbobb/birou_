# ── اختيار الـ IA ───────────────────────────────────
AI_PROVIDER=groq

# ── Groq (مجاني) ────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChatGPT / OpenAI (اختياري) ───────────────────────
#OPENAI_API_KEY=your_openai_api_key_here
#OPENAI_MODEL=gpt-4o-mini

# ── شخصية البوت ──────────────────────────────────────
BOT_NAME=Assistant
BOT_PERSONALITY=نت مساعد سمير، صاحب شقق مفروشة للكراء اليومي فمراكش. الأثمنة من 200 لـ 600 درهم للليلة. للتواصل: 0680040002.
BOT_LANGUAGE=الدارجة المغربية

# ── إعدادات الردود ───────────────────────────────────
RESPONSE_DELAY_MIN=1000
RESPONSE_DELAY_MAX=3000
RESPOND_TO_PRIVATE=true
RESPOND_TO_GROUPS=false
IGNORED_NUMBERS=
PAUSE_KEYWORD=!pause
RESUME_KEYWORD=!resume

# ── MySQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=whatsapp_user
DB_PASSWORD=your_strong_password_here
DB_NAME=whatsapp_bot

# ── Facebook Messenger (اختياري) ─────────────────────
#FACEBOOK_PAGE_ACCESS_TOKEN=
#FACEBOOK_VERIFY_TOKEN=

# ── لوحة التحكم ──────────────────────────────────────
DASHBOARD_PASSWORD=change_this_password
PORT=3000

# ── HTTPS (اختياري) ───────────────────────────────────
# فعّل HTTPS بتحديد مسار شهادة SSL (مثلاً من Let's Encrypt)
# SSL_CERT=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# PORT=443
