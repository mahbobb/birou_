{
  "name": "whatsapp-auto-responder",
  "version": "1.0.0",
  "description": "Répondeur automatique WhatsApp avec IA Claude",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "prod": "pm2 start ecosystem.config.js",
    "logs": "pm2 logs whatsapp-bot",
    "logs:ar": "wt.exe -d \".\" --title \"🤖 Bot Logs\" cmd /k \"chcp 65001 && pm2 logs --raw\"",
    "stop": "pm2 stop whatsapp-bot",
    "restart": "pm2 restart whatsapp-bot",
    "contacts": "node show-contacts.js",
    "setup-db": "node setup-db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "groq-sdk": "^0.37.0",
    "multer": "^2.1.1",
    "mysql2": "^3.18.2",
    "openai": "^6.25.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "^1.26.0"
  }
}
